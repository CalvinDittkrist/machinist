  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Operator submits a prompt, an approved command, and a logical repository name",
        "Store records exactly one job and one run; a unique runs.job_id enforces it",
        "Worker polls outbound with the bearer token, holds a 30s lease, heartbeats every 10s",
        "Runner spawns the executor in the repo, pipes the prompt to stdin, streams output",
        "Exit 0 succeeds; any other exit, timeout, or cancel fails; stale completions are rejected"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Control plane refuses non-loopback listen addresses; reach it only via SSH tunnel",
        "Worker endpoints need worker.token; browser submissions need CSRF plus loopback Origin",
        "API sends only names; worker.toml maps them to executor argv and repository paths",
        "Executor runs as the unprivileged machinist account with a sanitized environment",
        "Runner kills the whole process tree on timeout or cancel"
      ]
    },
    {
      "dot": "amber",
      "title": "Triggers and externals",
      "items": [
        "Scheduler loops every 30s per trigger: cron, interval, or github label",
        "GitHub triggers search issues by label via gh, check actor write permission, relabel machinist:queued",
        "Executors push branches and open pull requests; a human still merges",
        "machinist update pulls GitHub Releases and verifies SHA-256 before replacing the binary",
        "Codex and Claude Code CLIs use their own credentials on the worker host"
      ]
    }
  ]
